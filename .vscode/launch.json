{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run DICOM to NumPy",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "--dcm2npy",
        "True",
        "--input_dir",
        "./data/single_patient_dcm/",
        "--output_dir",
        "./output/"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
